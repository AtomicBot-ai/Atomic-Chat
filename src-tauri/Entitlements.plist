<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Bun runtime to allocate executable memory for JIT compilation -->
    <!-- Without this, MCP servers fail with "Ran out of executable memory" error -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Bundled/native tools (e.g. llama-server) may dlopen dylibs by name; Hardened Runtime blocks that without this. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice input captures from the microphone via CoreAudio. Strictly required
         only under App Sandbox, which this bundle does not use, but codesign
         records it and Hardened Runtime is happier with it declared. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>