{
  "comparator": "http-exchange",
  "expected": {
    "response": {
      "body": {
        "json": {
          "components": {
            "schemas": {
              "AnthropicMessage": {
                "description": "A single message in the Anthropic Messages API format.",
                "properties": {
                  "content": {
                    "description": "The content of the message.",
