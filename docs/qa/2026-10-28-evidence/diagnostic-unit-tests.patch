+it('QA: a stalled support send must expire instead of blocking all later messages', async () => {
+  reset()
+  vi.useFakeTimers()
+  client.createConversation.mockResolvedValue({
+    conversation_id: 'qa',
+    token: 'qa-token',
+  })
+  let release!: (value: { seq: number; created_at: string }) => void
+  client.sendMessage
+    .mockReset()
+    .mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          release = resolve
+        })
+    )
+    .mockResolvedValue({ seq: 2, created_at: '2026-10-28T12:00:00Z' })
+  const first = sendSupportMessage('First message')
+  await vi.advanceTimersByTimeAsync(1)
+  const second = sendSupportMessage('Second message')
+  await vi.advanceTimersByTimeAsync(600_000)
+  const statuses = store().messages.map((message) => message.status)
+  const sends = client.sendMessage.mock.calls.length
+  release({ seq: 1, created_at: '2026-10-28T12:00:00Z' })
+  await Promise.all([first, second])
+  vi.useRealTimers()
+  console.log(
+    'QA_SUPPORT_STALL',
+    JSON.stringify({ elapsedMs: 600000, statuses, sends })
+  )
+  expect(statuses).toContain('failed')
+})
